{
  "name": "@larsx2/raiden-ui",
  "version": "0.1.0",
  "private": true,
  "description": "The screens of the Raiden launcher.",
  "type": "module",
  "scripts": {
    "wasm": "node scripts/wasm.mjs",
    "dev": "node scripts/wasm.mjs && vite",
    "build": "node scripts/wasm.mjs && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scenes.json",
    "test": "node scripts/wasm.mjs && vitest run",
    "test:scenes": "node scripts/wasm.mjs && playwright test"
  },
  "dependencies": {
    "@tanstack/solid-virtual": "^3.13.55",
    "@tauri-apps/api": "^2.12.5",
    "highlight.js": "11.12.0",
    "solid-js": "^1.9.20"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^26",
    "happy-dom": "^20",
    "typescript": "^7",
    "vite": "^8.3.8",
    "vite-plugin-solid": "^2.11.17",
    "vitest": "^5"
  }
}
