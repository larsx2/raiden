#!/bin/sh
set -eu
while read -r _ _ remote_ref _; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "Nobody pushes to main. Push your branch and open a pull request: see CONTRIBUTING.md." >&2
    exit 1
  fi
done
cd "$(git rev-parse --show-toplevel)"
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
if [ -n "$(git status --porcelain)" ]; then
  echo "Commit everything, new files included, before pushing." >&2
  exit 1
fi
mise run lint
mise run test
